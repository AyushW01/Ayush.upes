Q67
Insert an Element at a Given Position
#include <stdio.h>
int main()
{
    int a[6], n = 5, value, pos, i;
    printf("Enter 5 elements: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);
    printf("Enter position: ");
    scanf("%d", &pos);
    printf("Enter value: ");
    scanf("%d", &value);
    for(i = n; i >= pos; i--)
        a[i] = a[i - 1];
    a[pos - 1] = value;
    n++;
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);
    return 0;
}


