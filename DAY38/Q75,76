Q75
Add Two Matrices
#include <stdio.h>
int main()
{
    int a[2][2], b[2][2], c[2][2];
    int i, j;
    printf("Enter first matrix:\n");
    for(i = 0; i < 2; i++)
    {
        for(j = 0; j < 2; j++)
            scanf("%d", &a[i][j]);
    }
    printf("Enter second matrix:\n");
    for(i = 0; i < 2; i++)
    {
        for(j = 0; j < 2; j++)
            scanf("%d", &b[i][j]);
    }
    for(i = 0; i < 2; i++)
    {
        for(j = 0; j < 2; j++)
            c[i][j] = a[i][j] + b[i][j];
    }
    printf("Sum Matrix:\n");
    for(i = 0; i < 2; i++)
    {
        for(j = 0; j < 2; j++)
            printf("%d ", c[i][j]);
        printf("\n");
    }
    return 0;
}




 Q76
Check if a Matrix is Symmetric
#include <stdio.h>
int main()
{
    int a[3][3];
    int i, j, flag = 1;
    printf("Enter 9 elements:\n");
    for(i = 0; i < 3; i++)
    {
        for(j = 0; j < 3; j++)
            scanf("%d", &a[i][j]);
    }
    for(i = 0; i < 3; i++)
    {
        for(j = 0; j < 3; j++)
        {
            if(a[i][j] != a[j][i])
                flag = 0;
        }
    }
    if(flag == 1)
        printf("Symmetric Matrix");
    else
        printf("Not Symmetric Matrix");
    return 0;
}
