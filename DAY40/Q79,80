Q79
Perform Diagonal Traversal of a Matrix
#include <stdio.h>
int main()
{
    int a[3][3];
    int i, j, k;
    printf("Enter 9 elements:\n");
    for(i = 0; i < 3; i++)
    {
        for(j = 0; j < 3; j++)
            scanf("%d", &a[i][j]);
    }
    printf("Diagonal Traversal:\n");
    for(k = 0; k <= 4; k++)
    {
        for(i = 0; i < 3; i++)
        {
            j = k - i;
            if(j >= 0 && j < 3)
                printf("%d ", a[i][j]);
        }
    }
    return 0;
}



 Q80
Multiply Two Matrices
#include <stdio.h>
int main()
{
    int a[2][2], b[2][2], c[2][2];
    int i, j, k;
    printf("Enter first matrix:\n");
    for(i = 0; i < 2; i++)
    {
        for(j = 0; j < 2; j++)
            scanf("%d", &a[i][j]);
    }
    printf("Enter second matrix:\n");
    for(i = 0; i < 2; i++)
    {
        for(j = 0; j < 2; j++)
            scanf("%d", &b[i][j]);
    }
    for(i = 0; i < 2; i++)
    {
        for(j = 0; j < 2; j++)
        {
            c[i][j] = 0;
            for(k = 0; k < 2; k++)
                c[i][j] = c[i][j] + a[i][k] * b[k][j];
        }
    }
    printf("Multiplication Matrix:\n");
    for(i = 0; i < 2; i++)
    {
        for(j = 0; j < 2; j++)
            printf("%d ", c[i][j]);
        printf("\n");
    }
    return 0;
}
