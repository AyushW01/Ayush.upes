SWAP FIRST AND LAST DIGIT 


#include <stdio.h>

int main()
{
    int n, first, last, temp, place=1;

    printf("Enter number: ");
    scanf("%d", &n);

    last = n%10;
    temp = n;

    while(temp >= 10)
    {
        temp = temp/10;
        place = place*10;
    }

    first = temp;

    n = n - first*place - last;
    n = n + last*place + first;

    printf("After swap = %d", n);

    return 0;
}






PERFECT NUMBER 

#include <stdio.h>

int main()
{
    int n, i, sum=0;

    printf("Enter number: ");
    scanf("%d", &n);

    for(i=1; i<n; i++)
    {
        if(n%i == 0)
            sum = sum+i;
    }

    if(sum == n)
        printf("Perfect Number");
    else
        printf("Not Perfect Number");

    return 0;
}
