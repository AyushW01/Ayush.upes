Q69
Second Largest Element in an Array
#include <stdio.h>
int main()
{
    int a[5], i, largest, second;
    printf("Enter 5 elements: ");
    for(i = 0; i < 5; i++)
        scanf("%d", &a[i]);
    largest = second = -99999;
    for(i = 0; i < 5; i++)
    {
        if(a[i] > largest)
        {
            second = largest;
            largest = a[i];
        }
        else if(a[i] > second && a[i] != largest)
            second = a[i];
    }
    printf("Second Largest = %d", second);
    return 0;
}


Q70
Rotate an Array to the Right by K Positions
#include <stdio.h>
int main()
{
    int a[5], i, j, k, temp;
    printf("Enter 5 elements: ");
    for(i = 0; i < 5; i++)
        scanf("%d", &a[i]);
    printf("Enter k: ");
    scanf("%d", &k);
    for(j = 1; j <= k; j++)
    {
        temp = a[4];
        for(i = 4; i > 0; i--)
            a[i] = a[i - 1];
        a[0] = temp;
    }
    printf("Rotated Array: ");
    for(i = 0; i < 5; i++)
        printf("%d ", a[i]);
    return 0;
}
