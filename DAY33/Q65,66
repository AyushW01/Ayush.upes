Q65
Binary Search in a Sorted Array
#include <stdio.h>
int main()
{
    int a[5], key, low = 0, high = 4, mid, i;
    printf("Enter sorted array: ");
    for(i = 0; i < 5; i++)
        scanf("%d", &a[i]);
    printf("Enter element: ");
    scanf("%d", &key);
    while(low <= high)
    {
        mid = (low + high) / 2;
        if(a[mid] == key)
        {
            printf("Found at position %d", mid + 1);
            return 0;
        }
        else if(key > a[mid])
            low = mid + 1;
        else
            high = mid - 1;
    }
    printf("Not Found");
    return 0;
}


 Q66
Insert an Element in a Sorted Array
#include <stdio.h>
int main()
{
    int a[6], n = 5, value, i;
    printf("Enter 5 sorted elements: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);
    printf("Enter element: ");
    scanf("%d", &value);
    i = n - 1;
    while(i >= 0 && a[i] > value)
    {
        a[i + 1] = a[i];
        i--;
    }
    a[i + 1] = value;
    n++;
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);
    return 0;
}
