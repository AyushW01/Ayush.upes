Q43--    STRONG NUMBER 


#include <stdio.h>

int main()
{
    int n, temp, rem, i, fact, sum=0;

    printf("Enter number: ");
    scanf("%d", &n);

    temp=n;

    while(n != 0)
    {
        rem=n%10;
        fact=1;

        for(i=1; i<=rem; i++)
            fact=fact*i;

        sum=sum+fact;
        n=n/10;
    }

    if(sum==temp)
        printf("Strong Number");
    else
        printf("Not Strong Number");

    return 0;
}





Q44 — Series: 1 + 3/4 + 5/6 + 7/8...




#include <stdio.h>

int main()
{
    int n, i;
    float sum=1;

    printf("Enter n: ");
    scanf("%d", &n);

    for(i=2; i<=n; i++)
        sum = sum + (float)(2*i-1)/(2*i);

    printf("Sum = %.2f", sum);

    return 0;
}
