 Q59
Count Even and Odd Numbers in an Array
#include <stdio.h>
int main()
{
    int a[5], i, even = 0, odd = 0;
    for(i = 0; i < 5; i++)
        scanf("%d", &a[i]);
    for(i = 0; i < 5; i++)
    {
        if(a[i] % 2 == 0)
            even++;
        else
            odd++;
    }
    printf("Even = %d\n", even);
    printf("Odd = %d", odd);
    return 0;
}

Q60
Count Positive, Negative and Zero Elements
#include <stdio.h>
int main()
{
    int a[5], i, p = 0, n = 0, z = 0;
    for(i = 0; i < 5; i++)
        scanf("%d", &a[i]);
    for(i = 0; i < 5; i++)
    {
        if(a[i] > 0)
            p++;
        else if(a[i] < 0)
            n++;
        else
            z++;
    }
    printf("Positive = %d\n", p);
    printf("Negative = %d\n", n);
    printf("Zero = %d", z);
    return 0;
}
