Q45 — Series: 2/3 + 4/7 + 6/11 + 8/15...



#include <stdio.h>

int main()
{
    int n, i;
    float sum=0;

    printf("Enter n: ");
    scanf("%d", &n);

    for(i=1; i<=n; i++)
        sum = sum + (float)(2*i)/(4*i-1);

    printf("Sum = %.2f", sum);

    return 0;
}



Q46 — Rectangle of Stars

#include <stdio.h>

int main()
{
    int i, j;

    for(i=1; i<=6; i++)
    {
        for(j=1; j<=6; j++)
            printf("*");

        printf("\n");
    }

    return 0;
}
