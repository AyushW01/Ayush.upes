Q55
Print All Prime Numbers from 1 to N
#include <stdio.h>
int main()
{
    int n, i, j, count;
    printf("Enter n: ");
    scanf("%d", &n);
    for(i = 2; i <= n; i++)
    {
        count = 0;
        for(j = 1; j <= i; j++)
        {
            if(i % j == 0)
                count++;
        }
        if(count == 2)
            printf("%d ", i);
    }
    return 0;
}

 Q56
Read and Print a One-Dimensional Array
#include <stdio.h>
int main()
{
    int a[5], i;
    printf("Enter 5 elements: ");
    for(i = 0; i < 5; i++)
        scanf("%d", &a[i]);
    printf("Array: ");
    for(i = 0; i < 5; i++)
        printf("%d ", a[i]);
    return 0;
}
